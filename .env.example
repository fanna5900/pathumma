# EDUNEXA Configuration Environment Variables
PORT=5000
NODE_ENV=development

# Database connection:
# SQLite (default for instant portable local execution):
DATABASE_URL="file:./dev.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/edunexa?schema=public"

# Authentication:
JWT_SECRET=edunexa_super_secure_jwt_secret_key_2026_academic_portal
JWT_EXPIRES_IN=7d

# Google Gemini API key (optional: if omitted, EDUNEXA's internal role-aware Academic Knowledge Engine provides full response generation)
GEMINI_API_KEY=

# Client URL:
CLIENT_URL=http://localhost:3000
