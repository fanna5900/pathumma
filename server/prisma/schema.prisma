generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          String    // STUDENT, FACULTY, UNIVERSITY, ADMIN
  status        String    @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  emailVerified Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studentProfile    StudentProfile?
  facultyProfile    FacultyProfile?
  universityProfile UniversityProfile?

  // Relational connections
  uploadedMaterials       LearningMaterial[]
  bookmarkedResources     ResourceBookmark[]
  assignmentsCreated      Assignment[]
  assignmentSubmissions   AssignmentSubmission[]
  studyProfile            StudyProfile?
  sentPartnerRequests     StudyPartnerRequest[]  @relation("SentRequests")
  receivedPartnerRequests StudyPartnerRequest[]  @relation("ReceivedRequests")
  connections1            StudyPartnerConnection[] @relation("User1Connections")
  connections2            StudyPartnerConnection[] @relation("User2Connections")
  groupMemberships        StudyGroupMember[]
  hostedSessions          StudySession[]
  academicEvents          AcademicEvent[]
  aiConversations         AIConversation[]
  notifications           Notification[]
  communityPosts          CommunityPost[]
  communityComments       CommunityComment[]
  filedReports            ContentReport[]
  auditLogs               AuditLog[]
  savedInstitutions       SavedInstitution[]
  admissionApplications   AdmissionApplication[]
}

model StudentProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  age                  Int?
  gender               String?
  phone                String?
  country              String   @default("India")
  state                String?
  district             String?
  educationLevel       String?  // Higher Secondary, Undergraduate, Postgraduate, etc.
  preferredCourse      String?
  preferredInstitution String?
  admissionStatus      String   @default("LOOKING_FOR_ADMISSION") // ALREADY_ADMITTED, LOOKING_FOR_ADMISSION
  bio                  String?
  avatarUrl            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model FacultyProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName              String
  phone                 String?
  institutionName       String
  departmentName        String
  designation           String
  subjectSpecialization String
  professionalInfo      String?
  approvalStatus        String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model UniversityProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionName   String
  officialEmail     String
  phone             String?
  address           String?
  country           String   @default("India")
  state             String
  city              String
  website           String?
  institutionType   String   // CENTRAL_UNIVERSITY, STATE_UNIVERSITY, DEEMED_UNIVERSITY, AUTONOMOUS, PRIVATE, GOVT
  verificationDocs  String?
  approvalStatus    String   @default("APPROVED") // PENDING, APPROVED, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Institution {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  logoUrl             String?
  bannerUrl           String?
  location            String
  address             String
  city                String
  state               String
  country             String   @default("India")
  institutionType     String   // Central University, State University, IIT, NIT, Autonomous, Govt, Deemed, Private
  affiliation         String?
  officialWebsite     String
  contactEmail        String
  contactPhone        String
  facilities          String   // JSON or comma separated: Library, Labs, Sports, Hostels, Wi-Fi, Incubation
  scholarships        String?  // Details of available scholarships
  verificationStatus  String   @default("VERIFIED") // VERIFIED, PENDING, UNVERIFIED
  officialSource      String   @default("Institutional Records / UGC / NIRF")
  lastVerificationDate DateTime @default(now())
  rating              Float    @default(4.5)
  establishedYear     Int?
  nirfRank            Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  campuses            Campus[]
  departments         Department[]
  courses             Course[]
  learningMaterials   LearningMaterial[]
  savedBy             SavedInstitution[]
  applications        AdmissionApplication[]
}

model Campus {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  location      String
  address       String
}

model Department {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?

  courses       Course[]
  subjects      Subject[]
  materials     LearningMaterial[]
}

model Course {
  id                String      @id @default(uuid())
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title             String
  code              String
  level             String      // UNDERGRADUATE, POSTGRADUATE, DIPLOMA, DOCTORAL
  durationYears     Int
  description       String
  eligibility       String
  totalSeats        Int         @default(60)
  admissionProcess  String
  academicYear      String      @default("2026-2027")
  verified          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  fees              CourseFee[]
  semesters         Semester[]
  learningMaterials LearningMaterial[]
  assignments       Assignment[]
  applications      AdmissionApplication[]
}

model CourseFee {
  id                  String   @id @default(uuid())
  courseId            String
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academicYear        String   @default("2026-2027")
  period              String   @default("ANNUAL") // ANNUAL, SEMESTER, TOTAL
  tuitionFee          Float
  admissionFee        Float    @default(0)
  examFee             Float    @default(0)
  labFee              Float    @default(0)
  hostelFee           Float    @default(0)
  otherFee            Float    @default(0)
  totalFee            Float
  scholarshipAvailable Boolean  @default(false)
  officialSource      String   @default("Official Fee Gazette")
  lastVerifiedDate    DateTime @default(now())
  isEstimate          Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model Semester {
  id             String    @id @default(uuid())
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterNumber Int
  title          String    // e.g. "Semester 1", "First Year"

  subjects       Subject[]
  materials      LearningMaterial[]
}

model Subject {
  id           String      @id @default(uuid())
  semesterId   String
  semester     Semester    @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  code         String
  credits      Int         @default(4)
  description  String?

  materials    LearningMaterial[]
  assignments  Assignment[]
}

model LearningMaterial {
  id            String      @id @default(uuid())
  title         String
  description   String
  resourceType  String      // SYLLABUS, NOTES, PREVIOUS_QUESTION_PAPER, QUESTION_BANK, VIDEO_LESSON, REFERENCE, ASSIGNMENT_RESOURCE, PRACTICAL_RECORD, LAB_MANUAL, REVISION_NOTES
  fileUrl       String?
  externalUrl   String?
  fileType      String      @default("pdf") // pdf, doc, mp4, link
  fileSize      String?     @default("2.4 MB")
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courseId      String?
  course        Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semesterId    String?
  semester      Semester?   @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  subjectId     String?
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploadedById  String
  uploadedBy    User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  approvalStatus String     @default("APPROVED") // PENDING, APPROVED, REJECTED
  sourceInfo    String      @default("Academic Department Verified")
  downloadCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  bookmarks     ResourceBookmark[]
}

model ResourceBookmark {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   LearningMaterial @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([userId, resourceId])
}

model Assignment {
  id          String    @id @default(uuid())
  facultyId   String
  faculty     User      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String
  deadline    DateTime
  totalMarks  Int       @default(100)
  attachmentUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id             String     @id @default(uuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionUrl  String?
  content        String?
  submittedAt    DateTime   @default(now())
  marksObtained  Int?
  feedback       String?
  status         String     @default("SUBMITTED") // SUBMITTED, GRADED, LATE
}

model SavedInstitution {
  id            String      @id @default(uuid())
  studentId     String
  student       User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([studentId, institutionId])
}

model AdmissionApplication {
  id                String      @id @default(uuid())
  studentId         String
  student           User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  institutionId     String
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  applicationNumber String      @unique
  status            String      @default("INTERESTED") // INTERESTED, PREPARING_DOCUMENTS, READY_TO_APPLY, SUBMITTED, UNDER_REVIEW, ACCEPTED, REJECTED, WAITLISTED
  notes             String?
  isOfficial        Boolean     @default(false)
  submissionDate    DateTime?
  
  // Comprehensive 7-Step Admission Details
  applicantName     String?
  dob               String?
  gender            String?
  nationality       String?     @default("Indian")
  email             String?
  phone             String?
  address           String?
  place             String?
  district          String?
  state             String?
  pincode           String?
  fatherName        String?
  fatherPhone       String?
  motherName        String?
  motherPhone       String?
  guardianName      String?
  guardianPhone     String?
  sslcSchool        String?
  sslcBoard         String?
  sslcYear          String?
  sslcPercentage    String?
  plusTwoSchool     String?
  plusTwoBoard      String?
  plusTwoStream     String?
  plusTwoYear       String?
  plusTwoPercentage String?
  previousQualification String?
  academicYear      String?     @default("2026-2027")
  admissionType     String?     @default("Merit")
  additionalPreference String?
  documents         String?     // Serialized JSON of uploaded documents
  declarationAgreed Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model StudyProfile {
  id                String   @id @default(uuid())
  studentId         String   @unique
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjects          String   // Comma-separated or JSON list of subjects
  course            String
  semester          String   // e.g. "Semester 4"
  preferredLanguage String   @default("English")
  studyGoals        String
  availableTimes    String   // e.g. "Evenings 6-9 PM, Weekends"
  learningStyle     String   @default("VISUAL") // VISUAL, AUDITORY, READING_WRITING, KINESTHETIC
  groupPreference   String   @default("BOTH") // ONLINE, OFFLINE, BOTH
  isDiscoverable    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StudyPartnerRequest {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User     @relation("ReceivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  message     String?
  status      String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudyPartnerConnection {
  id        String   @id @default(uuid())
  user1Id   String
  user1     User     @relation("User1Connections", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id   String
  user2     User     @relation("User2Connections", fields: [user2Id], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
}

model StudyGroup {
  id          String             @id @default(uuid())
  name        String
  description String
  subject     String
  course      String
  creatorId   String
  maxMembers  Int                @default(10)
  isPrivate   Boolean            @default(false)
  meetingLink String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  members     StudyGroupMember[]
  sessions    StudySession[]
}

model StudyGroupMember {
  id        String     @id @default(uuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String     @default("MEMBER") // ADMIN, MEMBER
  joinedAt  DateTime   @default(now())

  @@unique([groupId, userId])
}

model StudySession {
  id          String      @id @default(uuid())
  title       String
  description String?
  subject     String
  startTime   DateTime
  endTime     DateTime
  hostId      String
  host        User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  groupId     String?
  group       StudyGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  meetingLink String?
  status      String      @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdAt   DateTime    @default(now())
}

model AcademicEvent {
  id            String    @id @default(uuid())
  title         String
  description   String?
  eventType     String    // EXAM, DEADLINE, LECTURE, HOLIDAY, WORKSHOP, REVISION
  startDate     DateTime
  endDate       DateTime?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String?
  courseId      String?
  createdAt     DateTime  @default(now())
}

model AIConversation {
  id          String                  @id @default(uuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String                  @default("New Discussion")
  roleContext String                  @default("STUDENT") // STUDENT, FACULTY, UNIVERSITY, ADMIN
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  messages    AIConversationMessage[]
}

model AIConversationMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // USER, ASSISTANT, SYSTEM
  content        String
  createdAt      DateTime       @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // ADMISSION, ASSIGNMENT, STUDY_PARTNER, MATERIAL, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model CommunityPost {
  id         String             @id @default(uuid())
  authorId   String
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  content    String
  subject    String
  tags       String?
  likesCount Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  comments   CommunityComment[]
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
}

model ContentReport {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  itemType   String   // RESOURCE, POST, USER, STUDY_PARTNER
  itemId     String
  reason     String
  details    String?
  status     String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @default(now())
}
